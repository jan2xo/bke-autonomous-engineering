{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bke.local/schemas/autonomous-consumer-check-registry-v1.json",
  "title": "BKE Consumer Check Registry",
  "type": "object",
  "required": ["version", "checks"],
  "properties": {
    "version": {"const": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "depends_on", "executor", "stage", "capsule_label"],
        "properties": {
          "id": {"type": "string", "pattern": "^repo\\.[a-z0-9][a-z0-9.-]*$"},
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
          },
          "executor": {
            "type": "object",
            "required": ["kind", "argv"],
            "properties": {
              "kind": {"const": "command"},
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          },
          "stage": {"enum": ["worker-loop", "convergence", "certification"]},
          "capsule_label": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
